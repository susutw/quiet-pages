---
import '../styles/global.css';
import { site } from '../../site.config';

interface Props {
  title?: string;
  description?: string;
  tab?: string;
  wide?: boolean;
}

const { title, description = site.description, tab, wide = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : site.title;
const path = Astro.url.pathname;
const current = tab ?? site.tabs.find((t) => path.startsWith(t.href))?.key;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600&display=swap"
    />
  </head>
  <body>
    <div class:list={['page', { wide }]}>
      <header class="site-header">
        <a class="site-title" href="/">{site.title}</a>
        <nav class="tabs" aria-label="分頁">
          {
            site.tabs.map((t) => (
              <a href={t.href} aria-current={current === t.key ? 'page' : undefined}>
                {t.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        {site.footer || `© ${new Date().getFullYear()} ${site.author}`}
      </footer>
    </div>
  </body>
</html>
