---
import { published, formatDate, url } from '../lib';

const posts = await published('blog');
---

{
  posts.length === 0 ? (
    <p class="empty">還沒有文章。</p>
  ) : (
    <ul class="blog-list">
      {posts.map((post) => (
        <li>
          <a href={url(`/blog/${post.id}/`)}>
            <span class="title">{post.data.title}</span>
            <time class="meta" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </a>
          {post.data.description && <p class="desc">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-top: 2.2rem;
  }
  a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
  }
  .title {
    transition: color 0.2s;
  }
  a:hover .title {
    color: var(--muted);
  }
  time {
    flex-shrink: 0;
  }
  .desc {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }
</style>
